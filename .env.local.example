# Copy this file to .env.local and fill in real values before deploying
# with analytics/ads enabled. All are optional for local development.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads conversion ID (e.g. AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Public site URL, used for canonical tags, Open Graph, and sitemap.xml.
# Set this to the Vercel deployment URL (or custom domain later).
NEXT_PUBLIC_SITE_URL=https://fix4u.vercel.app

# --- Future email notification service (not yet wired up) ---
# Uncomment and fill in when adding real email sending in
# components/ContactForm.tsx -> sendEmailNotification().
# RESEND_API_KEY=
# WEB3FORMS_ACCESS_KEY=
